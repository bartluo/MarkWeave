# MarkWeave 部署配置示例
# 使用方式：cp .env.example .env，然后填写真实值

# ── 认证服务 ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
AUTH_ADMIN_KEY=change-me-to-a-long-random-string

# 可选：Google / GitHub OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 可选：SMTP 邮件发送（注册邮箱验证码）。不配置时开发模式会把验证码打印到认证服务日志。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MarkWeave <no-reply@markweave.app>
# 仅开发环境：固定验证码，便于本地联调。
EMAIL_VERIFY_DEV_CODE=

# ── 授权服务 ────────────────────────────────────────────────
LICENSE_ADMIN_KEY=change-me-to-a-long-random-string
# 可选：直接粘贴授权私钥；留空则首次启动时自动生成
LICENSE_PRIVATE_KEY=

# ── 支付服务 ────────────────────────────────────────────────
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://pay.markweave.cloud/v1/webhooks/alipay

WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=https://pay.markweave.cloud/v1/webhooks/wechat
WECHAT_CERT_PRIVATE_KEY_PATH=

CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_SERVER=prod
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_COMMERCIAL=
CREEM_PRODUCT_TRIAL=
