# Payment Server 环境变量

# 服务端口
PORT=3220
# 数据库路径
PAYMENT_DB_PATH=./data/payment.db
# License Server 管理 API
LICENSE_SERVER_URL=http://localhost:3210
LICENSE_ADMIN_KEY=change-me-to-a-long-random-string
TRUST_PROXY=false

# ── 支付宝配置 ──────────────────────────────────────────────────
# 应用 AppID（从支付宝开放平台获取）
ALIPAY_APP_ID=2021001123456789
# 应用私钥（PKCS8 格式）
ALIPAY_PRIVATE_KEY=MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
# 支付宝公钥（用于验签回调）
ALIPAY_ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# 支付宝网关（沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 异步通知地址（可回显，服务器地址，支付宝会 POST 到此路径）
ALIPAY_NOTIFY_URL=http://your-domain.com/v1/webhooks/alipay

# ── 微信支付配置 ──────────────────────────────────────────────────
# 商户 AppID（公众号/小程序/APP 的 appid）
WECHAT_APP_ID=wx1234567890abcdef
# 商户号（mch_id）
WECHAT_MCH_ID=1234567890
# 商户密钥（API 密钥，32 位，在商户平台设置）
WECHAT_API_KEY=your32characterapikeyhere
# 证书私钥路径（用于退款等需要双向认证的操作）
WECHAT_CERT_PRIVATE_KEY_PATH=
# 异步通知地址
WECHAT_NOTIFY_URL=http://your-domain.com/v1/webhooks/wechat

# ── Creem 配置 ──────────────────────────────────────────────────
# Creem API Key（从 https://creem.io/dashboard/developers 获取）
# 生产：creem_ 开头；测试：ck_test_ 开头
CREEM_API_KEY=creem_your_api_key_here
# Creem Webhook Secret
CREEM_WEBHOOK_SECRET=your_webhook_secret_here
# Creem 环境：prod 或 test
CREEM_SERVER=prod
# Creem 产品 ID（在 Creem Dashboard → Products 中创建后复制）
CREEM_PRODUCT_PRO=prod_pro_product_id
CREEM_PRODUCT_COMMERCIAL=prod_commercial_product_id
CREEM_PRODUCT_TRIAL=prod_trial_product_id
