# 认证服务器环境变量示例
# 复制为 .env 后按需修改（.env 不应提交到仓库）

AUTH_SERVER_PORT=3230
AUTH_DB_PATH=./data/auth.db

# 必填：JWT 签名密钥，用 `openssl rand -hex 32` 生成
JWT_SECRET=change-me-to-a-long-random-string

# 管理端 Bearer Token，用 `openssl rand -hex 32` 生成固定随机串
AUTH_ADMIN_KEY=change-me-to-a-long-random-string

# 可选：Google / GitHub OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 可选：SMTP 邮件发送（注册邮箱验证码）。未配置时开发环境会把验证码打印到日志。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MarkWeave <no-reply@markweave.app>

# 仅开发环境：未配置 SMTP 时使用固定验证码，便于本地联调。
EMAIL_VERIFY_DEV_CODE=123456
