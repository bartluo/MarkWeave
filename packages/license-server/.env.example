# 授权服务器环境变量示例
# 复制为 .env 后按需修改（.env 不应提交到仓库）

PORT=3210
LICENSE_DB_PATH=./data/license.db
# 私钥路径。必须与客户端内置公钥（packages/desktop/src/main/license/publicKey.ts）匹配。
LICENSE_PRIVATE_KEY_PATH=./data/license-private.pem
# 管理端 Bearer Token，用 `openssl rand -hex 32` 生成固定随机串
LICENSE_ADMIN_KEY=change-me-to-a-long-random-string
# 处于反向代理（Caddy/Nginx）之后时设为 true
TRUST_PROXY=true
